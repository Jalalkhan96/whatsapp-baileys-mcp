# Copy to .env and adjust. All values are optional.

# Number for pairing-code login (international format, digits only)
WA_PHONE_NUMBER=

# Session folder (default ./session) — NEVER share or commit this folder
# WA_SESSION_DIR=./session

# Comma list of JIDs/numbers the agent may send to. Empty = allow all.
# WA_SEND_ALLOWLIST=923001234567,120363000000000000@g.us

# Owner number, reported by wa_status
# WA_OWNER_NUMBER=

# Optional proxy for the WhatsApp connection
# HTTPS_PROXY=http://127.0.0.1:8080
